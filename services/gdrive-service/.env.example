# Configuración del Microservicio Google Drive para Visor XR
PORT=4000
NODE_ENV=development

# Credenciales de Google Cloud OAuth 2.0 (Google Drive API v3)
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_secreto_de_cliente
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Orígenes autorizados para CORS (separados por comas si son varios)
FRONTEND_ORIGIN=https://localhost:5173,https://192.168.100.24:5173,https://vickman123.github.io

# Clave secreta para firmar sesiones JWT encriptadas
SESSION_SECRET=visor_xr_secret_drive_session_jwt_key_32_chars_min
